@model System.Collections.Generic.IEnumerable<Product>
@{ ViewBag.Title = "Sản phẩm"; }
<div class="titlebar"><h1>Sản phẩm</h1><a class="button button-primary" href="@Url.Action("Create")">Thêm sản phẩm</a></div>
<form class="catalog-form" method="get" action="@Url.Action("Index")">
    <div class="field search-field"><label for="q">Tìm sản phẩm</label><input type="search" name="q" id="q" value="@ViewBag.Query" maxlength="100" placeholder="Nhập tên sản phẩm" /></div>
    <button type="submit" class="button button-outline">Tìm kiếm</button>
</form>
@if (!Model.Any()) { <div class="empty"><h2>Không tìm thấy sản phẩm</h2></div> }
else
{
    <div class="table-frame"><table class="data-table">
        <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Danh mục</th><th scope="col">Giá</th><th scope="col">Tồn kho</th><th scope="col">Hiển thị</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td><div class="table-product"><img src="@Url.Content(product.ImagePath)" alt="" loading="lazy" width="44" height="50" /><span>@product.Name</span></div></td>
                <td>@product.Category.Name</td><td>@ShopText.Money(product.Price)</td><td>@product.Stock</td>
                <td><span class="state @(product.IsActive ? "state-Completed" : "")">@(product.IsActive ? "Đang bán" : "Đã ẩn")</span></td>
                <td><div class="table-actions">
                    <a class="table-link" href="@Url.Action("Edit", new { id = product.Id })">Sửa</a>
                    @using (Html.BeginForm("Delete", "Products", FormMethod.Post, new { data_confirm = "Bạn muốn xóa sản phẩm này? Nếu đã có đơn, sản phẩm sẽ được ẩn." }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@product.Id" />
                        <button class="link-button danger" type="submit">Xóa</button>
                    }
                </div></td>
            </tr>
        }
        </tbody>
    </table></div>
}
