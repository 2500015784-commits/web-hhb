@model DashboardPage
@{ ViewBag.Title = "Tổng quan"; }
<div class="titlebar"><h1>Tổng quan</h1></div>
<div class="stats">
    <div><span>Sản phẩm đang bán</span><strong>@Model.Products</strong></div>
    <div><span>Tổng số đơn</span><strong>@Model.Orders</strong></div>
    <div><span>Đơn chờ xác nhận</span><strong>@Model.Pending</strong></div>
    <div><span>Doanh thu đã hoàn tất</span><strong>@ShopText.Money(Model.Revenue)</strong></div>
</div>
<section class="panel-card">
    <div class="section-head"><h2>Đơn mới nhất</h2><a class="text-link" href="@Url.Action("Index", "Orders")">Xem đơn hàng ↗</a></div>
    @if (Model.Recent.Count == 0) { <p>Chưa có đơn hàng.</p> }
    else { @Html.Partial("~/Areas/Admin/Views/Orders/_OrderTable.cshtml", Model.Recent) }
</section>
