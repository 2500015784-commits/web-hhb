@model CustomerLoginInput
@{ ViewBag.Title = "Đăng nhập"; }
<section class="shell section customer-account">
    <div class="panel-card">
        <h1>Đăng nhập</h1>
        <p>Đăng nhập để thanh toán và xem lại hóa đơn của bạn.</p>
        @using (Html.BeginForm("Login", "CustomerAccount", FormMethod.Post, new { @class = "stack" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.ReturnUrl)
            @Html.ValidationSummary(true)
            <div class="field">@Html.LabelFor(x => x.Email) @Html.TextBoxFor(x => x.Email, new { type = "email", autocomplete = "username", maxlength = 150, required = "required" }) @Html.ValidationMessageFor(x => x.Email)</div>
            <div class="field">@Html.LabelFor(x => x.Password) @Html.PasswordFor(x => x.Password, new { autocomplete = "current-password", maxlength = 256, required = "required" }) @Html.ValidationMessageFor(x => x.Password)</div>
            <button class="button button-primary" type="submit">Đăng nhập</button>
        }
        <p class="account-switch">Chưa có tài khoản? <a class="text-link" href="@Url.Action("Register", new { returnUrl = Model.ReturnUrl })">Đăng ký</a></p>
    </div>
</section>
