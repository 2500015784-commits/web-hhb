@model RegisterInput
@{ ViewBag.Title = "Đăng ký"; }
<section class="shell section customer-account">
    <div class="panel-card">
        <h1>Đăng ký</h1>
        @using (Html.BeginForm("Register", "CustomerAccount", FormMethod.Post, new { @class = "stack" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.ReturnUrl)
            @Html.ValidationSummary(true)
            <div class="field">@Html.LabelFor(x => x.Name) @Html.TextBoxFor(x => x.Name, new { autocomplete = "name", maxlength = 100, required = "required" }) @Html.ValidationMessageFor(x => x.Name)</div>
            <div class="field">@Html.LabelFor(x => x.Email) @Html.TextBoxFor(x => x.Email, new { type = "email", autocomplete = "username", maxlength = 150, required = "required" }) @Html.ValidationMessageFor(x => x.Email)</div>
            <div class="field">@Html.LabelFor(x => x.Password) @Html.PasswordFor(x => x.Password, new { autocomplete = "new-password", minlength = 12, maxlength = 256, required = "required" }) @Html.ValidationMessageFor(x => x.Password)<small>Ít nhất 12 ký tự.</small></div>
            <div class="field">@Html.LabelFor(x => x.ConfirmPassword) @Html.PasswordFor(x => x.ConfirmPassword, new { autocomplete = "new-password", maxlength = 256, required = "required" }) @Html.ValidationMessageFor(x => x.ConfirmPassword)</div>
            <button class="button button-primary" type="submit">Tạo tài khoản</button>
        }
        <p class="account-switch">Đã có tài khoản? <a class="text-link" href="@Url.Action("Login", new { returnUrl = Model.ReturnUrl })">Đăng nhập</a></p>
    </div>
</section>
