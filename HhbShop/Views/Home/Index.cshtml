@model HomePage
@{ ViewBag.Title = "Trang chủ"; }
<section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Bộ sưu tập thường ngày</p>
        <h1 id="hero-title">Mặc đẹp theo <em>cách của bạn.</em></h1>
        <p class="hero-lead">Từ chiếc áo đi làm đến đôi giày cuối tuần, chọn những món bạn muốn mặc nhiều lần.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="@Url.Action("Index", "Product")">Xem sản phẩm <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#danh-muc">Mua theo danh mục <span aria-hidden="true">↓</span></a>
        </div>
    </div>
    <div class="hero-picture">
        <img src="@Url.Content("~/Content/images/studio-cover.jpg")" alt="Người mẫu mặc áo khoác dáng dài màu be trong studio" fetchpriority="high" width="1000" height="1120" />
    </div>
</section>
<section class="shell section categories-section" id="danh-muc" aria-labelledby="categories-title">
    <div class="section-head"><h2 id="categories-title">Mua theo danh mục</h2></div>
    <div class="home-categories">
        @foreach (var category in Model.Categories.Take(4))
        {
            <a href="@Url.Action("Index", "Product", new { categoryId = category.Id })"><span>@category.Name</span><span aria-hidden="true">↗</span></a>
        }
    </div>
</section>
<section class="shell section" aria-labelledby="featured-title">
    <div class="section-head">
        <h2 id="featured-title">Sản phẩm nổi bật</h2>
        <a class="text-link" href="@Url.Action("Index", "Product")">Xem tất cả <span aria-hidden="true">↗</span></a>
    </div>
    @if (Model.Featured.Count == 0) { <div class="empty"><p>Cửa hàng đang cập nhật sản phẩm.</p></div> }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Featured) { @Html.Partial("_ProductCard", product) }
        </div>
    }
</section>
