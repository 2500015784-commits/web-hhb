@model CartPage
@{ ViewBag.Title = "Giỏ hàng"; }
<section class="shell section">
    <div class="crumb"><a href="@Url.Action("Index", "Home")">Trang chủ</a><span>›</span><span>Giỏ hàng</span></div>
    <div class="titlebar"><h1>Giỏ hàng</h1><a class="text-link" href="@Url.Action("Index", "Product")">← Tiếp tục mua sắm</a></div>
    @if (Model.Lines.Count == 0)
    {
        <div class="empty"><h2>Giỏ hàng đang trống</h2><p>Khám phá cửa hàng để tìm món bạn thích.</p><a class="button button-primary" href="@Url.Action("Index", "Product")">Xem sản phẩm</a></div>
    }
    else
    {
        <div class="purchase-grid">
            <div class="basket">
                @foreach (var item in Model.Lines)
                {
                    <article class="basket-item">
                        @if (item.Product != null)
                        {
                            <img class="cart-thumb" src="@Url.Content(item.Product.ImagePath)" alt="@item.Product.Name" width="90" height="100" />
                        }
                        else { <div class="cart-thumb"></div> }
                        <div class="basket-copy">
                            <h2>@(item.Product == null ? "Sản phẩm không còn bán" : item.Product.Name)</h2>
                            <p>@ShopText.Money(item.Product == null ? 0 : item.Product.Price)</p>
                            @if (!item.Available) { <p class="out-stock">Kiểm tra lại số lượng hoặc xóa sản phẩm này.</p> }
                            <div class="cart-controls">
                                @if (item.Product != null && item.Product.IsActive && item.Product.Stock > 0)
                                {
                                    using (Html.BeginForm("Update", "ShoppingCart", FormMethod.Post, new { @class = "quantity-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <label class="sr-only" for="qty-@item.Id">Số lượng @item.Product.Name</label>
                                        <input id="qty-@item.Id" type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Min(99, item.Product.Stock)" required />
                                        <button class="button button-small button-outline" type="submit">Cập nhật</button>
                                    }
                                }
                                @using (Html.BeginForm("Remove", "ShoppingCart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input name="id" type="hidden" value="@item.Id" />
                                    <button class="link-button danger" type="submit" aria-label="Xóa @(item.Product == null ? "sản phẩm" : item.Product.Name)">Xóa</button>
                                }
                            </div>
                        </div>
                        <strong class="line-total">@ShopText.Money(item.Total)</strong>
                    </article>
                }
            </div>
            <aside class="summary">
                <h2>Tóm tắt giỏ hàng</h2>
                <div class="summary-line"><span>Tạm tính</span><strong>@ShopText.Money(Model.Total)</strong></div>
                <div class="summary-line"><span>Phí giao hàng</span><span>0 ₫</span></div>
                <div class="summary-line grand-total"><span>Tổng cộng</span><strong>@ShopText.Money(Model.Total)</strong></div>
                @if (Model.CanCheckout) { <a class="button button-primary button-block" href="@Url.Action("Checkout")">Tiến hành đặt hàng <span aria-hidden="true">↗</span></a> }
                else { <p class="out-stock">Vui lòng cập nhật giỏ hàng trước khi đặt.</p> }
            </aside>
        </div>
    }
</section>
